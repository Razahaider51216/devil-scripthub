local function decode(value)
    local seed,checksum,size,text=value:match("^(%d+):(%d+):(%d+):(.+)$")
    assert(seed,"Invalid VM payload")
    local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup={}
    for i=1,64 do lookup[alphabet:byte(i)]=i-1 end
    local output={};local bits,count=0,0
    local state,previous,actual=tonumber(seed),tonumber(seed)%256,0
    for i=1,#text do
        local digit=lookup[text:byte(i)]
        if digit then
            bits=bits*64+digit;count+=6
            if count>=8 then
                count-=8;local divisor=2^count
                local byte=math.floor(bits/divisor);bits%=divisor
                state=state*48271%2147483647
                local decoded=(byte-state%256-previous)%256
                previous=byte;actual=(actual*33+decoded)%4294967296
                output[#output+1]=string.char(decoded)
            end
        end
    end
    local result=table.concat(output)
    assert(#result==tonumber(size) and actual==tonumber(checksum),"VM payload integrity mismatch")
    return result
end

local startupEnv=type(getgenv)=="function" and getgenv() or _G
local startupEntry="loader"
local startup={entry=startupEntry,release="hub-5-vm-1",status="Starting",placeId=game and game.PlaceId,universeId=game and game.GameId,
    capabilities={loadstring=type(loadstring)=="function",buffer=type(buffer)=="table",bit32=type(bit32)=="table",hookfunction=type(hookfunction)=="function" or type(hookfunc)=="function"}}
startupEnv.DevilHubStartupReports=startupEnv.DevilHubStartupReports or {}
startupEnv.DevilHubStartupReports[startupEntry]=startup
local function saveStartup()
    if type(writefile)~="function" then return end
    pcall(function()
        local file="DevilHub_Startup_"..startupEntry:gsub("[^%w]","_")..".json"
        writefile(file,game:GetService("HttpService"):JSONEncode(startup))
    end)
end
saveStartup()
local startupArgs=table.pack(...)
local startupOutcome=table.pack(xpcall(function()
    assert(type(loadstring)=="function","DEVIL HUB: executor loadstring is unavailable")
    assert(type(buffer)=="table" and type(bit32)=="table","DEVIL HUB: executor buffer/bit32 APIs are unavailable")
    startup.status="Compiling bootstrap"
    local run,err=loadstring(decode("2131467951:2079667175:66614:"),"Devil VM")
    assert(run,err)
    startup.status="Running"
    saveStartup()
    return run(table.unpack(startupArgs,1,startupArgs.n))
end,function(err)
    local message=tostring(err)
    if debug and type(debug.traceback)=="function" then return debug.traceback(message,2) end
    return message
end))
startup.ok=startupOutcome[1]
startup.status=startup.ok and "Returned; GUI readiness is tracked by the game entry" or "Failed"
if not startup.ok then startup.error=tostring(startupOutcome[2]) end
local loading=startupEnv.DevilRideLoading
if startup.ok and loading and loading.Failed then startup.status="Ride startup failed";startup.error=loading.LastError;startup.ok=false end
saveStartup()
if not startup.ok then
    local message=tostring(startup.error or "Startup failed")
    warn("[DEVIL HUB] "..message)
    pcall(function() game:GetService("StarterGui"):SetCore("SendNotification",{Title="DEVIL HUB • Startup failed",Text=message:sub(1,180),Duration=15}) end)
    error(message,0)
end
return table.unpack(startupOutcome,2,startupOutcome.n)
